# Copy to .env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=8080

# Local dev points at the docker-compose Postgres/Redis.
DATABASE_URL=postgresql://arena:arena_dev_pw@localhost:5432/arena?schema=public
REDIS_URL=redis://localhost:6379

# Used by docker-compose for the Postgres container password.
POSTGRES_PASSWORD=arena_dev_pw

# Comma-separated allowed origins, or * for any (dev).
CORS_ORIGINS=*
LOG_LEVEL=debug
