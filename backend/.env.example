# Copy to .env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=8080

# Local dev points at the docker-compose Postgres/Redis.
DATABASE_URL=postgresql://arena:arena_dev_pw@localhost:5432/arena?schema=public
REDIS_URL=redis://localhost:6379

# Used by docker-compose for the Postgres container password.
POSTGRES_PASSWORD=arena_dev_pw

# Comma-separated allowed origins, or * for any (dev).
CORS_ORIGINS=*
LOG_LEVEL=debug

# Auth — generate a strong secret for production (openssl rand -hex 32).
JWT_SECRET=dev-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Optional social login (verify ID tokens); leave unset to disable.
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=
